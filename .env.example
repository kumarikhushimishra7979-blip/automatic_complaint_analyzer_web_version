# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server & Security Configuration
PORT=3000
JWT_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Storage & Upload Limits
DATABASE_PATH="./backend_data/complaints.db"
UPLOAD_DIR="./backend_uploads"
MAX_UPLOAD_SIZE_MB=25

# ML Inference Configuration
MODEL_PATH="./server/ml/models/trained_model.json"
CONFIDENCE_THRESHOLD=0.40
MIN_CLUSTER_SIZE=2

# CORS Configuration
CORS_ORIGINS="http://localhost:3000"

# Frontend API Base URL (optional; defaults to relative /api)
VITE_API_BASE_URL="/api"
